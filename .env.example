# Backend: process environment wins, then root .env, then backend/.env.
GEMINI_API_KEY=your-gemini-api-key-here

# Leave GEMINI_MODEL unset to use the operation defaults:
# extraction/search: gemini-3.5-flash-lite; writing/feedback: gemini-3.8-flash.
# An existing explicit global override remains supported.
# GEMINI_MODEL=gemini-3.8-flash

# Model precedence: operation override > writing group > global > default.
# GEMINI_MODEL_EXTRACTION=gemini-3.5-flash-lite
# GEMINI_MODEL_SEARCH=gemini-3.5-flash-lite
# GEMINI_MODEL_WRITING=gemini-3.8-flash
# GEMINI_MODEL_TAILOR=gemini-3.8-flash
# GEMINI_MODEL_COVER_LETTER=gemini-3.8-flash
# GEMINI_MODEL_DOSSIER=gemini-3.8-flash
# GEMINI_MODEL_QUESTIONS=gemini-3.8-flash
# GEMINI_MODEL_EVALUATION=gemini-3.8-flash

# Backend persistence defaults to backend/.data/careeros.sqlite3 (ignored).
# Use an absolute path for a custom file; relative paths use the process cwd.
# CAREEROS_DB_PATH=/absolute/path/to/careeros.sqlite3

# Next proxy setting: put this in frontend/.env.local or its process environment.
# Root .env is read by the backend, not automatically by Next.
# API_BASE=http://127.0.0.1:8000
